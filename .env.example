# ============================================================
# Financial Market Platform — Environment Variables
# Copy this file to .env and fill in your real values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Host-side port for pytest and dbt. Defaults to 5433 rather than 5432 to avoid
# clashing with a locally-installed PostgreSQL server. If you have no native
# Postgres on this machine, 5432 works too — just keep it in sync with the
# published port in docker-compose.yml.
POSTGRES_PORT=5433
POSTGRES_DB=market_data
POSTGRES_USER=market_user
POSTGRES_PASSWORD=changeme_dev_only

# --- Data APIs ---
POLYGON_API_KEY=your_polygon_key_here
ALPHA_VANTAGE_API_KEY=
OPENFIGI_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO